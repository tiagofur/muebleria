{
  "name": "granete",
  "private": true,
  "version": "0.0.0",
  "description": "Furniture quotation and production system — pnpm monorepo",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "openapi:generate": "python3 scripts/generate_openapi.py",
    "openapi:check": "python3 scripts/check_openapi_drift.py",
    "build": "pnpm -r --if-present run build",
    "build:desktop": "pnpm --filter @granete/desktop package",
    "release:desktop": "pnpm --filter @granete/desktop dist",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "visual": "playwright test --config=playwright.config.ts",
    "smoke": "playwright test --config=playwright.config.ts tests/smoke",
    "test:organization:browser": "scripts/organization-browser-gate.sh",
    "smoke:perf": "playwright test --config=playwright.config.ts tests/smoke/proyectar-perf.spec.ts",
    "smoke:usability": "playwright test --config=playwright.config.ts tests/smoke/proyectar-usability.spec.ts"
  },

  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "playwright",
      "electron-winstaller",
      "7zip-bin",
      "app-builder-bin"
    ]
  }
}
