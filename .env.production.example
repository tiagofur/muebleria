# =============================================================================
# Granete — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before deploying.
#   cp .env.production.example .env
#   chmod 600 .env
#
# NEVER commit .env to version control.
#
# Generate secure values:
#   JWT_SECRET=$(openssl rand -base64 48)
#   REFRESH_TOKEN_PEPPER=$(openssl rand -base64 48)
#   MEDIA_SIGNING_KEY=$(openssl rand -base64 48)
#   MFA_ENCRYPTION_KEYS (see the MFA section below)
#   POSTGRES_PASSWORD=$(openssl rand -base64 32)
# =============================================================================

# ---------- Domain (required) ----------
# Used by Caddy for TLS certificate issuance and CORS allowlist.
DOMAIN=app.granete.io

# ---------- PostgreSQL (required) ----------
POSTGRES_USER=granete_prod
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
POSTGRES_DB=granete_prod
APP_DATABASE_PASSWORD=replace-with-a-distinct-runtime-password

# ---------- Backend (required) ----------
# JWT_SECRET: >= 32 bytes. The server refuses to boot if missing or too short.
# JWT_ISSUER (optional): ver5 token issuer; defaults to "granete-api".
# JWT_KEYRING (optional): JSON {"active_kid":"k1","keys":{"k1":"...","k0":"..."}}
# for zero-downtime key rotation (#460/ADR-0007). New tokens are signed with
# active_kid; every registered key stays valid for validation. When migrating
# from a bare JWT_SECRET, register the old secret under kid "legacy" or
# outstanding ver4 tokens fail closed.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
# Independent from JWT keys; changing it invalidates every outstanding refresh
# credential and must be coordinated with server-side session revocation.
REFRESH_TOKEN_PEPPER=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
# #460 SEC-3 — signs short-lived, resource-scoped media read grants. Shares no
# primitive with the JWT keys or the refresh pepper; rotating it invalidates
# outstanding media grants only (they expire within minutes by design).
MEDIA_SIGNING_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ---------- MFA secret protection (#460 SEC-7, required) ----------
# Dedicated keyring: TOTP secrets are AES-256-GCM encrypted and recovery
# codes hash to keyed verifiers under HKDF subkeys of this material. Never
# share it with the JWT keys/refresh pepper/media key. Rotation-shaped JSON:
# {"active_kid":"k1","keys":{"k1":"<base64 32B>","k0":"<base64 32B>"}}
# Stored factors are kid-pinned: removing a kid fails its material closed
# (users re-enroll). Single-key form also accepted: MFA_ENCRYPTION_KEY.
#   k1 value: openssl rand -base64 32
MFA_ENCRYPTION_KEYS=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
PORT=8080

# ---------- CORS (required for production) ----------
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ALLOWED_ORIGINS=https://app.granete.io
# #460 SEC-4A: GRANETE_ENV is pinned to "production" by docker-compose.prod.yml
# (not overridable here), so production can never resolve the Web refresh
# cookie to Secure=false — an explicit WEB_REFRESH_COOKIE_SECURE=false would
# refuse boot. WEB_REFRESH_COOKIE_SECURE=true is optional: the default "auto"
# already resolves Secure in production (non-loopback CORS origins).
#GRANETE_ENV=production
#WEB_REFRESH_COOKIE_SECURE=true

# ---------- Rate Limiting (optional, sensible defaults) ----------
RATE_LIMIT_RPS=0.5
RATE_LIMIT_BURST=10

# ---------- Media Storage (optional) ----------
# Inside the container this is always /data/media (the volume mount point).
MEDIA_DIR=/data/media
