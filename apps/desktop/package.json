{
  "name": "@granete/desktop",
  "version": "1.0.0",
  "description": "Granete — Sistema de cotización y producción de muebles para talleres de carpintería",
  "author": "Tiago Furtado",
  "private": true,
  "type": "module",
  "main": "./electron/main.mjs",

  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "ELECTRON_DEV=1 electron .",
    "start": "electron .",
    "dev:app": "node ./scripts/dev-app.mjs",
    "prepackage": "node ./scripts/generate-icons.mjs",
    "package": "pnpm --filter @granete/web build && pnpm prepackage && electron-builder --dir",
    "dist": "pnpm --filter @granete/web build && pnpm prepackage && electron-builder",
    "dist:win": "pnpm --filter @granete/web build && pnpm prepackage && electron-builder --win",
    "dist:mac": "pnpm --filter @granete/web build && pnpm prepackage && electron-builder --mac",
    "dist:linux": "pnpm --filter @granete/web build && pnpm prepackage && electron-builder --linux"
  },
  "build": {
    "appId": "com.granete.app",
    "productName": "Granete",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      "package.json"
    ],
    "extraMetadata": {
      "main": "./electron/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Granete"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },

    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "tiagofur",
      "repo": "muebleria"
    }
  },
  "dependencies": {
    "@granete/domain": "workspace:*",
    "@granete/storage": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "electron": "^35.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

