# Multi-stage production build for Granete React Web application
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.29.0 --activate

WORKDIR /app

# Copy dependency manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/domain/package.json ./packages/domain/
COPY packages/excel/package.json ./packages/excel/
COPY packages/storage/package.json ./packages/storage/
COPY packages/ui/package.json ./packages/ui/
COPY apps/web/package.json ./apps/web/

# Install dependencies (skipping optional desktop/mobile dependencies)
RUN pnpm install --frozen-lockfile --filter "@granete/web..."

# Copy source trees
COPY tsconfig.base.json ./
COPY packages/domain ./packages/domain
COPY packages/excel ./packages/excel
COPY packages/storage ./packages/storage
COPY packages/ui ./packages/ui
COPY apps/web ./apps/web

# Build frontend bundle
ENV NODE_ENV=production
RUN pnpm --filter "@granete/web" build

# Minimal static asset container (to copy into Caddy or serve directly)
FROM alpine:3.20

WORKDIR /srv
COPY --from=builder /app/apps/web/dist /srv

CMD ["sh", "-c", "echo 'Static web assets ready at /srv' && sleep infinity"]
